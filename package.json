{
  "name": "restoreyt",
  "version": "1.0.0",
  "description": "Restore original YouTube titles, thumbnails, descriptions, and selected audio",
  "author": "Jamie",
  "license": "MIT",
  "private": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint src/ tests/ tools/spike/",
    "typecheck": "tsc --noEmit",
    "build": "node ./esbuild.config.mjs",
    "watch": "node ./esbuild.config.mjs --watch",
    "package": "npm run build && node scripts/package.mjs",
    "test:spike": "node --test tools/spike/*.test.mjs",
    "versioncheck": "node scripts/verify-version.mjs",
    "verify": "npm run versioncheck && npm run lint && npm run typecheck && npm test && npm run test:spike && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.27.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
