{
  "name": "deslopify",
  "version": "1.0.0",
  "description": "Remove AI auto-translated titles, thumbnails, descriptions, and audio from YouTube",
  "author": "Jamie",
  "license": "MIT",
  "private": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "build": "node ./esbuild.config.mjs",
    "watch": "node ./esbuild.config.mjs --watch",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.27.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
